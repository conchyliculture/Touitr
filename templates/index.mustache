
        <header class="header">
            <div class="search-container">
                <input 
                    type="text" 
                    id="searchInput" 
                    class="search-input" 
                    placeholder="Search posts..."
                >
                <button id="clearSearch" class="clear-btn" style="display: none;">✕</button>
            </div>

            <button
                type="button"
                id="advancedToggle"
                class="advanced-toggle"
                aria-expanded="false"
                aria-controls="advancedPanel"
            >
                <span class="advanced-toggle-label">Advanced search</span>
                <span class="advanced-toggle-arrow">▾</span>
                <span id="advancedBadge" class="advanced-badge" style="display: none;"></span>
            </button>

            <div id="advancedPanel" class="advanced-panel" style="display: none;">
                <label class="advanced-check">
                    <input type="checkbox" id="filterMedia">
                    <span>Only posts with media</span>
                </label>

                <div class="advanced-dates">
                    <label class="advanced-field">
                        <span class="advanced-label">From date</span>
                        <input type="date" id="filterFrom" class="date-input">
                    </label>
                    <label class="advanced-field">
                        <span class="advanced-label">Until date</span>
                        <input type="date" id="filterUntil" class="date-input">
                    </label>
                </div>

                <div class="advanced-actions">
                    <span id="filterSummary" class="filter-summary"></span>
                    <button type="button" id="resetFilters" class="reset-filters">Clear filters</button>
                </div>
            </div>
        </header>

        <main class="timeline" id="timeline">
            <!-- Posts will be dynamically inserted here -->
        </main>

        <div id="loading" class="loading">
            <div class="spinner"></div>
            <p>Loading more posts...</p>
        </div>

        <div id="noResults" class="no-results" style="display: none;">
            <p>No posts found matching your search.</p>
        </div>
    </div>

    <script src="{{scriptjs_url}}"></script>
